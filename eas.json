{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.19.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.19.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.multimagics.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.19.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.multimagics.com"
      },
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6814432815",
        "appleTeamId": "57DRRU3SP7"
      }
    }
  }
}
