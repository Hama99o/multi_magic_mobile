+// MultiMagic notes (patch-package, B 2.2.3): the text colour (fgColor),
+// highlight, subscript and superscript are drawn while editing. Colours come
+// from the mark's `display` (#rrggbb, set by the app's glue from the web's
+// hsl()/rgb() value); a highlight without one is the web's default yellow.
+private const val NOTE_HIGHLIGHT_DEFAULT = "#fef08a"
+
+internal fun applyNoteMarkSpans(builder: RenderTextBuilder, start: Int, end: Int, marks: List<Any>) {
+    if (start >= end) return
+    for (mark in marks) {
+        val type = when (mark) {
+            is String -> mark
+            is JSONObject -> mark.optString("type", "")
+            else -> ""
+        }
+        val display = (mark as? JSONObject)?.optString("display", "")?.takeIf { it.isNotBlank() }
+        when (type) {
+            "fgColor" -> display?.let { parseColor(it) }?.let {
+                builder.setSpan(ForegroundColorSpan(it), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+            "highlight" -> parseColor(display ?: NOTE_HIGHLIGHT_DEFAULT)?.let {
+                builder.setSpan(BackgroundColorSpan(it), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+            "subscript" -> {
+                builder.setSpan(SubscriptSpan(), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+                builder.setSpan(RelativeSizeSpan(0.75f), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+            "superscript" -> {
+                builder.setSpan(SuperscriptSpan(), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+                builder.setSpan(RelativeSizeSpan(0.75f), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+        }
+    }
+}
