# Copy to `.env` and fill in for YOUR machine. `.env` is gitignored; this file
# is the tracked documentation of what it must contain.
#
# `EXPO_PUBLIC_*` values are INLINED AT BUILD TIME, not read at runtime — see
# the header of src/config/env.ts. Changing one needs a new bundle.

# The multi_magic Rails host, WITHOUT the /api/v1 prefix: login lives at
# /users/login and the socket at /cable, both outside that namespace.
#
#   Android emulator -> http://10.0.2.2:3001   (the emulator's alias for the host)
#   iOS simulator    -> http://localhost:3001
#   a real device    -> http://<your machine's LAN IP>:3001
#
# Leave this unset on the Android emulator and src/config/env.ts falls back to
# 10.0.2.2:3001 in development. A RELEASE build refuses to start without it
# rather than silently talking to a developer's laptop.
EXPO_PUBLIC_API_URL=

# ActionCable. Derived from EXPO_PUBLIC_API_URL when blank (http -> ws, /cable),
# which is almost always what you want. Set it only if the socket is served from
# a different host.
EXPO_PUBLIC_WS_URL=

# The SAME host as EXPO_PUBLIC_API_URL, reachable from a SHELL on this machine.
#
# `10.0.2.2` is the emulator's alias for the host — correct for the app, and
# unreachable from a terminal. A preflight script asking "is the backend up?"
# needs localhost. Derived by substitution when blank, which is right whenever
# the app is pointed at the emulator alias.
EXPO_PUBLIC_API_URL_LOCAL=
